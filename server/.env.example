# Server
PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas)
MONGODB_URI=mongodb+srv://fewzan
:qPrcLrPLavYABaWT@node-tut.qzeazsc.mongodb.net/?appName=ecommerce

# Client origin (CORS + redirects)
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
# Then run: stripe listen --forward-to localhost:5000/api/orders/webhook
# and paste the "whsec_..." secret below to enable payment confirmation
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary (image uploads: https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional upload preset (created in Cloudinary dashboard Settings > Upload)
PRESET_NAME=

# Nodemailer (e.g. Gmail app password or Mailtrap for testing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Ecommerce <no-reply@example.com>"